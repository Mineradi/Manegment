rules_version = '2';

// Clinic Patient Manager — Firestore security rules.
// Authenticated staff (doctor / receptionist) can read all records and write
// only when not cross-collection spoofing. Deploys with:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Optional: restrict to a single staff account or a list of allowed emails.
    // function allowedStaff() {
    //   return request.auth.token.email in ['doctor@clinic.com'];
    // }

    match /patients/{patientId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == patientId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.village is string
        && request.resource.data.village.size() > 0;
      allow update, delete: if signedIn();
    }

    match /visits/{visitId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.patientId is string
        && request.resource.data.issue is string
        && request.resource.data.issue.size() > 0;
      allow update, delete: if signedIn();
    }

    // Counter document for sequential patient IDs.
    match /meta/{docId} {
      allow read, write: if signedIn();
    }
  }
}
